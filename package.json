{
  "name": "mcp-sapb1-sql",
  "version": "1.0.1",
  "description": "Servidor MCP para SAP Business One SQL Server - Compatible con Claude Desktop",
  "main": "dist/stdio-server.js",
  "type": "commonjs",
  "bin": {
    "mcp-sap-sql": "dist/stdio-server.js"
  },
  "scripts": {
    "dev": "ts-node src/stdio-server.ts",
    "dev:http": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/stdio-server.js",
    "start:http": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sql-server",
    "sap",
    "sap-business-one",
    "claude-desktop",
    "stdio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.2",
    "mssql": "^10.0.1",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

